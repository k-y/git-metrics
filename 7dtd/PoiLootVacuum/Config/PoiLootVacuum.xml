<?xml version="1.0" encoding="UTF-8"?>
<!--
  PoiLootVacuum client-side config.
  CollectKey : any UnityEngine.KeyCode name (e.g. F9, F10, KeypadPlus)
  Radius     : collection radius in metres (3D sphere).
               40 covers most POIs from inside; 80-100 for large POIs (skyscrapers, factories).
               Effective ceiling is ~150 — beyond that chunks are unloaded and nothing extra is found.
  Shift+CollectKey runs a dry-run scan without moving items.

  TagMappings: purely additive — hard-coded defaults are always active regardless of this block.
    Default tags per category:
      Weapon    : weapon
      Tool      : tool
      Armor     : armor
      Ammo      : ammo
      Food      : food
      Medicine  : medical
      Book      : books, csm
      Component : component
      Resource  : resource, junk
      Misc      : catch-all for anything that matches none of the above
    Add mod-specific tags here to extend a category without recompiling.
    Valid category names: Weapon, Tool, Armor, Ammo, Food, Medicine, Book, Component, Resource, Misc
-->
<PoiLootVacuum>
  <CollectKey value="F10" />
  <Radius value="40" />
  <!-- Collect everything regardless of tag/category settings -->
  <PickupAll value="false" />
  <!-- Where to put items: CrateOnly | InventoryOnly | InventoryThenCrate | CrateThenInventory -->
  <Destination value="CrateOnly" />
  <PickupWeapons value="true" />
  <PickupTools value="true" />
  <PickupArmor value="true" />
  <PickupAmmo value="true" />
  <PickupFood value="true" />
  <PickupMedicine value="true" />
  <PickupBooks value="true" />
  <PickupReadBooks value="false" />
  <PickupComponents value="true" />
  <PickupResources value="true" />
  <PickupMisc value="true" />

  <!--
    Add mod-specific tags here. Examples:
    <Tag name="myModWeapon" category="Weapon" />
    <Tag name="myModJunk"   category="Resource" />
  -->
  <TagMappings>
  </TagMappings>
</PoiLootVacuum>
