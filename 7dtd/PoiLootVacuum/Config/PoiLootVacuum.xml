<?xml version="1.0" encoding="UTF-8"?>
<!--
  PoiLootVacuum client-side config.
  CollectKey : any UnityEngine.KeyCode name (e.g. F9, F10, KeypadPlus)
  Radius     : collection radius in metres (3D sphere)
  Shift+CollectKey runs a dry-run scan without moving items.

  TagMappings: add extra item tags to a category without recompiling.
  Valid categories: Weapon, Tool, Armor, Ammo, Food, Medicine, Book, Component, Resource, Misc
  Default tags are always active; entries here are additive.
-->
<PoiLootVacuum>
  <CollectKey value="F10" />
  <Radius value="40" />
  <PickupWeapons value="true" />
  <PickupTools value="true" />
  <PickupArmor value="true" />
  <PickupAmmo value="true" />
  <PickupFood value="true" />
  <PickupMedicine value="true" />
  <PickupBooks value="true" />
  <PickupReadBooks value="false" />
  <PickupComponents value="true" />
  <PickupResources value="true" />
  <PickupMisc value="true" />

  <!--
    Add mod-specific tags here. Examples:
    <Tag name="myModWeapon" category="Weapon" />
    <Tag name="myModJunk"   category="Resource" />
  -->
  <TagMappings>
  </TagMappings>
</PoiLootVacuum>
