<configs>
  <append xpath="/nav_object_classes">

    <!-- ============================================================
         TechFreqs Visual Indicator - Custom nav object classes
         max_distance=100 so C# DetectionRadius is the effective limit
         ============================================================ -->

    <!-- Standard zombie: zombie head icon + health ring on-screen -->
    <nav_object_class name="TFVIzombie">
      <map_settings>
        <property name="sprite_name" value="ui_game_symbol_zombie"/>
        <property name="min_distance" value="0"/>
        <property name="max_distance" value="100"/>
        <property name="color" value="255,0,0,255"/>
        <property name="has_pulse" value="true"/>
      </map_settings>
      <compass_settings>
        <property name="sprite_name" value="ui_game_symbol_zombie"/>
        <property name="min_distance" value="0"/>
        <property name="max_distance" value="100"/>
        <property name="color" value="255,0,0,255"/>
        <property name="has_pulse" value="true"/>
        <property name="icon_clamped" value="false"/>
      </compass_settings>
      <onscreen_settings>
        <property name="sprite_name" value="ui_game_symbol_zombie"/>
        <property name="min_distance" value="0"/>
        <property name="max_distance" value="100"/>
        <property name="color" value="255,0,0,255"/>
        <property name="use_head_offset" value="true"/>
        <property name="offset" value="0,0.75,0"/>
        <property name="sprite_size" value="36"/>
        <property name="sprite_fill_type" value="Health"/>
        <property name="sprite_fill_name" value="ui_game_symbol_twitch_overhead_hp_ring"/>
        <property name="sprite_fill_color" value="90,0,0"/>
        <property name="text_type" value="Name"/>
      </onscreen_settings>
    </nav_object_class>

    <!-- Feral zombie: yellow tint -->
    <nav_object_class name="TFVIferal" extends="TFVIzombie">
      <map_settings>
        <property name="color" value="255,200,0,255"/>
