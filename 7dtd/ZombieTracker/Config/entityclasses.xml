<configs>
	<!-- Apply the permanent tracking buff to the player on every spawn/respawn -->
	<append xpath="/entity_classes/entity_class[@name='playerMale']">
		<effect_group>
			<triggered_effect trigger="onSelfFirstSpawn" action="AddBuff" buff="buffZombieTrackerAlways"/>
			<triggered_effect trigger="onSelfSpawn" action="AddBuff" buff="buffZombieTrackerAlways"/>
		</effect_group>
	</append>
	<append xpath="/entity_classes/entity_class[@name='playerFemale']">
		<effect_group>
			<triggered_effect trigger="onSelfFirstSpawn" action="AddBuff" buff="buffZombieTrackerAlways"/>
			<triggered_effect trigger="onSelfSpawn" action="AddBuff" buff="buffZombieTrackerAlways"/>
		</effect_group>
	</append>

	<!-- Assign NavObject to zombie template (inherited by all zombies as tier 1 default) -->
	<append xpath="/entity_classes/entity_class[@name='zombieTemplateMale']">
		<property name="NavObject" value="tfztracking1"/>
	</append>
	<!-- Override NavObject for higher-tier zombies -->
	<append xpath="/entity_classes/entity_class[contains(@name, 'Feral') and not(contains(@name, 'Radiated')) and not(contains(@name, 'Charged')) and not(contains(@name, 'Infernal'))]">
		<property name="NavObject" value="tfztracking2"/>
	</append>
	<append xpath="/entity_classes/entity_class[contains(@name, 'Radiated') and not(contains(@name, 'Charged')) and not(contains(@name, 'Infernal'))]">
		<property name="NavObject" value="tfztracking3"/>
	</append>
	<append xpath="/entity_classes/entity_class[contains(@name, 'Charged') and not(contains(@name, 'Infernal'))]">
		<property name="NavObject" value="tfztracking4"/>
	</append>
	<append xpath="/entity_classes/entity_class[contains(@name, 'Infernal')]">
		<property name="NavObject" value="tfztracking5"/>
	</append>

	<!-- Assign NavObject to animal template (passive/green as default for all animals) -->
	<append xpath="/entity_classes/entity_class[@name='animalTemplateMale']">
		<property name="NavObject" value="tfzanimal_passive"/>
	</append>
	<!-- Override to hostile (orange) for dangerous animals -->
	<append xpath="/entity_classes/entity_class[starts-with(@name, 'animal') and (contains(@name, 'Bear') or contains(@name, 'Direwolf') or contains(@name, 'Wolf') or contains(@name, 'Lion') or contains(@name, 'Vulture') or contains(@name, 'Dog') or contains(@name, 'Coyote') or contains(@name, 'Snake'))]">
		<property name="NavObject" value="tfzanimal_hostile"/>
	</append>
</configs>
