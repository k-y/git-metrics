<?xml version="1.0" encoding="UTF-8"?>
<!--
  EntityLabels client-side config.
  ToggleKey      : any UnityEngine.KeyCode name — press to show/hide (default F9)
  Radius         : detection + label draw distance in metres
  UpdateInterval : seconds between entity list refreshes (0.5–30)
  ShowType       : prefix label with category tag ([P] [T] [A] [Z] [MB] [B])
  ShowHealth     : append HP/MaxHP to the label
  ShowDist       : append distance in metres to the label
  ShowCompass    : show markers on the compass bar
  ShowMap        : show markers on the map
  Colors         : R,G,B as 0.0–1.0 floats (optional fourth value is alpha)
  Show*          : set false to hide that category entirely
-->
<EntityLabels>
  <ToggleKey value="F9" />
  <Radius value="80" />
  <UpdateInterval value="2" />
  <ShowType value="true" />
  <ShowHealth value="true" />
  <ShowDist value="true" />
  <ShowCompass value="true" />
  <ShowMap value="true" />
  <!-- Players -->
  <PlayerColor value="0,0.8,1" />
  <ShowPlayers value="true" />
  <!-- Traders / allied NPCs -->
  <TraderColor value="0,1,0.4" />
  <ShowTraders value="true" />
  <!-- Animals -->
  <AnimalColor value="0.9,0.7,0.2" />
  <ShowAnimals value="true" />
  <!-- Regular zombies -->
  <ZombieColor value="0.85,0.85,0.85" />
  <ShowZombies value="true" />
  <!-- Mini-bosses (tagged "miniboss") -->
  <MiniBossColor value="1,0.5,0" />
  <ShowMiniBosses value="true" />
  <!-- Bosses (tagged "boss") -->
  <BossColor value="1,0.15,0.15" />
  <ShowBosses value="true" />
</EntityLabels>
