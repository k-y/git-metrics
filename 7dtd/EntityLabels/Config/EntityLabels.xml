<?xml version="1.0" encoding="UTF-8"?>
<!--
  EntityLabels client-side config.
  ToggleKey  : any UnityEngine.KeyCode name — press once to show labels, again to hide (default F9)
  Radius     : label draw distance in metres (3-D sphere)
  FontSize   : label text height in pixels (8–18 recommended)
  ShowType   : prefix each label with a category tag ([P] [T] [A] [Z] [MB] [B])
  ShowHealth : append HP / MaxHP to the label
  ShowDist   : append distance in metres to the label
  Colors     : R,G,B as 0.0–1.0 floats (optional fourth value is alpha, default 1)
  Show*      : set false to hide that category entirely
-->
<EntityLabels>
  <ToggleKey value="F9" />
  <Radius value="80" />
  <FontSize value="11" />
  <ShowType value="true" />
  <ShowHealth value="true" />
  <ShowDist value="true" />
  <!-- Players -->
  <PlayerColor value="0,0.8,1" />
  <ShowPlayers value="true" />
  <!-- Traders / allied NPCs -->
  <TraderColor value="0,1,0.4" />
  <ShowTraders value="true" />
  <!-- Animals (friendly and hostile non-boss) -->
  <AnimalColor value="0.9,0.7,0.2" />
  <ShowAnimals value="true" />
  <!-- Regular zombies -->
  <ZombieColor value="0.85,0.85,0.85" />
  <ShowZombies value="true" />
  <!-- Mini-bosses (entities tagged "miniboss") -->
  <MiniBossColor value="1,0.5,0" />
  <ShowMiniBosses value="true" />
  <!-- Bosses (entities tagged "boss") -->
  <BossColor value="1,0.15,0.15" />
  <ShowBosses value="true" />
</EntityLabels>
